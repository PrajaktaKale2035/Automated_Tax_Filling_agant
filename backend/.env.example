# Backend environment variables — copy this to `.env` and fill in real values.
# `.env` is gitignored; never commit real keys.

# ---- Database ----------------------------------------------------------------
# Postgres 16 with pgvector extension. Defaults below match docker-compose.yml.
DATABASE_URL=postgresql://taxagent:taxagent_secure_password_2024@localhost:5432/tax_filing_db

# ---- Security ----------------------------------------------------------------
# 32+ byte secret used to sign JWTs. CHANGE THIS for any non-dev environment.
SECRET_KEY=dev_secret_key_change_in_production_32_chars_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fernet key for encrypting PAN / Aadhaar at rest. 32-byte URL-safe base64 string.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_32_byte_urlsafe_fernet_key_here

# ---- LLM providers -----------------------------------------------------------
# OpenAI is the default for the LangGraph chat / interviewer node. Without this
# the deterministic endpoints (/api/v2/calc/preview, /api/v2/filing/start, RAG
# search) still work; only /api/v2/filing/chat/* requires it.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: alternate providers. The frontend agent system supports switching
# between these via src/agents/llm/LLMProvider.ts; the backend currently uses
# only OpenAI (override in code if you want one of the others).
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here          # Gemini
GEMINI_API_KEY=your_gemini_api_key_here          # alias used by some libs

# ---- Application -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---- ITR / RAG output --------------------------------------------------------
# Where rendered ITR-1 PDFs are cached (also exposed via /api/v2/filing/{id}/pdf).
ITR_PDF_DIR=./app/uploads/itr1

# ---- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
