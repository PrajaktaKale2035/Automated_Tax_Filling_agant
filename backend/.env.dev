# Development Environment — copy this file to .env and fill in your values.
# DO NOT commit .env to version control (it is in .gitignore).

# ---------------------------------------------------------------------------
# Database
# Port 5436 on host maps to 5432 inside the Docker container (see docker-compose.yml).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://taxagent:taxagent_secure_password_2024@localhost:5436/tax_filing_db

# ---------------------------------------------------------------------------
# LLM Provider — uncomment ONE block.
#
# Option A: Ollama (local, no API key, default fallback when no provider set)
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
OLLAMA_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434

# Option B: Google Gemini (free tier available)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-flash-lite-latest

# Option C: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4

# ---------------------------------------------------------------------------
# Security
# Generate ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
SECRET_KEY=dev_secret_key_change_in_production_32_chars_minimum
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ENCRYPTION_KEY=your_fernet_key_here_generate_with_command_above

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# ---------------------------------------------------------------------------
# Optional — PDF output directory (defaults to app/uploads/itr1)
# ---------------------------------------------------------------------------
# ITR_PDF_DIR=app/uploads/itr1
